DATABASE_DSN="host=localhost user=postgres password=postgres dbname=tegami port=5432 sslmode=prefer"
# required in release mode at least 32 random characters
JWT_SECRET="secret"
LOG_LEVEL="info"
APP_PORT=8080
GIN_MODE=release
EXPOSE_SWAGGER=false
ARGON2_MEMORY=16384 # in KiB
ARGON2_THREADS=4
ARGON2_SALT_LEN=16
ARGON2_KEY_LEN=32
ARGON2_TIME=3