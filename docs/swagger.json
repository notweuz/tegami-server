{
    "swagger": "2.0",
    "info": {
        "description": "API documentation for Tegami Server.",
        "title": "Tegami API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/api",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns the current status of the app.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "status"
                ],
                "summary": "Get app health",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/health.InfoResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "health.InfoResponse": {
            "type": "object",
            "properties": {
                "commit": {
                    "type": "string",
                    "example": "2acec66b3b1efbe040f738b18cbb7f60f841fddc"
                },
                "status": {
                    "type": "string",
                    "example": "UP"
                },
                "uptime": {
                    "type": "string",
                    "example": "12.666100458s"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter \"Bearer \u003ctoken\u003e\" (token from /auth/login).",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}